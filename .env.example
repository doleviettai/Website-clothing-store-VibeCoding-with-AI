# ================================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Bản mẫu cấu hình môi trường - An toàn khi commit lên Github
# ================================================================================

# ----------------- CLOUDINARY CREDENTIALS -----------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=FashionShop2

# ----------------- ZALOPAY SANDBOX CREDENTIALS -----------------
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_CREATE_ORDER_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ORDER_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_CALLBACK_URL=http://localhost:8080/api/v1/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:5173/payment-result

# ----------------- MOMO SANDBOX CREDENTIALS -----------------
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_CREATE_ORDER_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ORDER_URL=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn
MOMO_REDIRECT_URL=http://localhost:5173/payment-result

# ----------------- VNPAY SANDBOX CREDENTIALS -----------------
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment-result
